<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= equipamento && equipamento.id ? 'Editar Equipamento' : 'Novo Equipamento' %> — Portal da Academia · FitCrew</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" href="/images/favicon.ico">
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/admin.css">
    <style>
    .sugestoes-lista {
        display:none; margin-top:6px; border:1px solid var(--border); border-radius:7px;
        max-height:220px; overflow-y:auto; background:var(--card);
    }
    .sugestao-item {
        padding:9px 12px; cursor:pointer; font-size:0.85rem; color:var(--text);
        display:flex; align-items:center; justify-content:space-between; gap:10px;
        border-bottom:1px solid var(--border);
    }
    .sugestao-item:last-child { border-bottom:none; }
    .sugestao-item:hover { background:var(--gold-dim); }
    .sugestao-item small { color:var(--text-muted); white-space:nowrap; }
    .sugestao-vazia { padding:12px; font-size:0.82rem; color:var(--text-muted); }
    .vinculo-selecionado {
        margin-top:10px; padding:10px 12px; border:1px solid var(--border); border-radius:7px;
        background:var(--surface); font-size:0.85rem; display:none;
    }
    </style>
</head>
<body class="admin-body">
<section class="admin-wrapper">
    <%- include('./_sidebar') %>
    <section class="admin-content">
        <header class="admin-topbar">
            <span class="admin-topbar-title">Equipamentos</span>
            <section class="admin-topbar-right">
                <span class="admin-topbar-admin">Olá, <strong><%= gymAdmin.nome.split(' ')[0] %></strong></span>
                <a href="/gym-admin/logout" class="btn admin-btn-logout"><i class="fas fa-sign-out-alt"></i> Sair</a>
            </section>
        </header>

        <main class="admin-main">
            <h1 class="admin-page-title"><%= equipamento && equipamento.id ? 'Editar Equipamento' : 'Novo Equipamento' %></h1>
            <p class="admin-page-subtitle"><%= gymAdmin.gym_nome %></p>

            <% if (erro) { %>
            <section class="admin-toast" style="position:static;margin-bottom:20px;border-left-color:var(--error)">
                <i class="fas fa-exclamation-circle" style="color:var(--error)"></i> <%= erro %>
            </section>
            <% } %>

            <section class="admin-card" style="max-width:560px">
                <section class="admin-card-body">
                    <form method="POST"
                          action="<%= equipamento && equipamento.id ? '/gym-admin/equipamentos/' + equipamento.id : '/gym-admin/equipamentos' %>"
                          id="formEquipamento">
                        <section class="admin-form-group">
                            <label>Nome do equipamento *</label>
                            <input type="text" name="nome" id="campoNome" class="admin-input"
                                placeholder="Ex: Leg Press 3, Supino 1, Estação de polia..." maxlength="100" required
                                value="<%= equipamento ? equipamento.nome || '' : '' %>">
                        </section>

                        <section class="admin-form-group">
                            <label>Exercício vinculado *</label>
                            <input type="text" id="campoBuscaExercicio" class="admin-input" autocomplete="off"
                                placeholder="Digite pra buscar o exercício correspondente...">
                            <input type="hidden" name="exercise_id" id="campoExerciseId"
                                value="<%= exercicioSelecionado ? exercicioSelecionado.id : '' %>">

                            <section id="listaSugestoes" class="sugestoes-lista"></section>

                            <section id="vinculoAtual" class="vinculo-selecionado"
                                style="display:<%= exercicioSelecionado ? 'block' : 'none' %>">
                                <i class="fas fa-check-circle" style="color:var(--success)"></i>
                                Vinculado a <strong id="vinculoAtualNome"><%= exercicioSelecionado ? (exercicioSelecionado.name_pt || exercicioSelecionado.name) : '' %></strong>
                            </section>

                            <small class="text-muted">A sugestão aparece conforme você digita. Nenhum equipamento fica sem exercício vinculado.</small>
                        </section>

                        <section style="display:flex;gap:10px;margin-top:16px">
                            <button type="submit" class="btn btn-gold" style="flex:1;justify-content:center">
                                <i class="fas fa-save"></i> Salvar
                            </button>
                            <a href="/gym-admin/equipamentos" class="btn btn-outline">Cancelar</a>
                        </section>
                    </form>
                </section>
            </section>
        </main>
    </section>
</section>

<script>
const campoNome         = document.getElementById('campoNome');
const campoBusca        = document.getElementById('campoBuscaExercicio');
const campoExerciseId   = document.getElementById('campoExerciseId');
const listaSugestoes    = document.getElementById('listaSugestoes');
const vinculoAtual      = document.getElementById('vinculoAtual');
const vinculoAtualNome  = document.getElementById('vinculoAtualNome');

let buscaTocada = false;
let timerBusca  = null;

async function buscarSugestoes() {
    const termo = campoBusca.value.trim();
    if (termo.length < 2) {
        listaSugestoes.innerHTML = '';
        listaSugestoes.style.display = 'none';
        return;
    }
    try {
        const r = await fetch(`/gym-admin/equipamentos/sugestoes?nome=${encodeURIComponent(termo)}`);
        renderSugestoes(await r.json());
    } catch (_) { /* falha de rede — usuário pode tentar de novo */ }
}

function renderSugestoes(lista) {
    if (!lista.length) {
        listaSugestoes.innerHTML = '<section class="sugestao-vazia">Nenhum exercício encontrado. Tente outro termo.</section>';
        listaSugestoes.style.display = 'block';
        return;
    }
    listaSugestoes.innerHTML = lista.map(ex => `
        <section class="sugestao-item" data-id="${ex.id}" data-nome="${String(ex.name_pt || ex.name).replace(/"/g, '&quot;')}">
            <span>${ex.name_pt || ex.name}</span>
            <small>${ex.target_muscle || ''}</small>
        </section>
    `).join('');
    listaSugestoes.style.display = 'block';
}

campoNome.addEventListener('input', () => {
    if (buscaTocada) return;
    campoBusca.value = campoNome.value;
    clearTimeout(timerBusca);
    timerBusca = setTimeout(buscarSugestoes, 300);
});

campoBusca.addEventListener('input', () => {
    buscaTocada = true;
    clearTimeout(timerBusca);
    timerBusca = setTimeout(buscarSugestoes, 300);
});

listaSugestoes.addEventListener('click', (e) => {
    const item = e.target.closest('.sugestao-item');
    if (!item) return;
    campoExerciseId.value = item.dataset.id;
    vinculoAtualNome.textContent = item.dataset.nome;
    vinculoAtual.style.display = 'block';
    listaSugestoes.innerHTML = '';
    listaSugestoes.style.display = 'none';
    campoBusca.value = '';
});

document.addEventListener('click', (e) => {
    if (!listaSugestoes.contains(e.target) && e.target !== campoBusca) {
        listaSugestoes.style.display = 'none';
    }
});

document.getElementById('formEquipamento').addEventListener('submit', (e) => {
    if (!campoExerciseId.value) {
        e.preventDefault();
        alert('Selecione o exercício vinculado antes de salvar — digite no campo de busca e escolha uma sugestão.');
    }
});
</script>
</body>
</html>
