<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= plano && plano.id ? 'Editar Plano' : 'Novo Plano' %> — Portal da Academia · FitCrew</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" href="/images/favicon.ico">
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
<section class="admin-wrapper">
    <%- include('./_sidebar') %>
    <section class="admin-content">
        <header class="admin-topbar">
            <span class="admin-topbar-title">Planos</span>
            <section class="admin-topbar-right">
                <span class="admin-topbar-admin">Olá, <strong><%= gymAdmin.nome.split(' ')[0] %></strong></span>
                <a href="/gym-admin/logout" class="btn admin-btn-logout"><i class="fas fa-sign-out-alt"></i> Sair</a>
            </section>
        </header>

        <main class="admin-main">
            <h1 class="admin-page-title"><%= plano && plano.id ? 'Editar Plano' : 'Novo Plano' %></h1>
            <p class="admin-page-subtitle">Plano de mensalidade de <%= gymAdmin.gym_nome %></p>

            <% if (erro) { %>
            <section class="admin-toast" style="position:static;margin-bottom:20px;border-left-color:var(--error)">
                <i class="fas fa-exclamation-circle" style="color:var(--error)"></i> <%= erro %>
            </section>
            <% } %>

            <section class="admin-card" style="max-width:520px">
                <section class="admin-card-body">
                    <form method="POST" action="<%= plano && plano.id ? '/gym-admin/planos/' + plano.id : '/gym-admin/planos' %>">
                        <section class="admin-form-group">
                            <label>Nome do plano *</label>
                            <input type="text" name="nome" class="admin-input"
                                placeholder="Ex: Mensal, Trimestral, Anual" maxlength="120" required
                                value="<%= plano ? plano.nome || '' : '' %>">
                        </section>
                        <section class="admin-form-group">
                            <label>Duração (dias) *</label>
                            <input type="number" name="duracao_dias" class="admin-input" min="1" max="3650" required
                                value="<%= plano ? plano.duracao_dias || '' : '' %>">
                        </section>
                        <section class="admin-form-group">
                            <label>Preço (R$) *</label>
                            <input type="number" name="preco" class="admin-input" min="0" step="0.01" required
                                value="<%= plano ? plano.preco || '' : '' %>">
                        </section>
                        <section style="display:flex;gap:10px">
                            <button type="submit" class="btn btn-gold" style="flex:1;justify-content:center">
                                <i class="fas fa-save"></i> Salvar
                            </button>
                            <a href="/gym-admin/planos" class="btn btn-outline">Cancelar</a>
                        </section>
                    </form>
                </section>
            </section>
        </main>
    </section>
</section>
</body>
</html>
