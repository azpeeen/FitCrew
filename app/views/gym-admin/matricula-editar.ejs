<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Matrícula — Portal da Academia · FitCrew</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" href="/images/favicon.ico">
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
<section class="admin-wrapper">
    <%- include('./_sidebar') %>
    <section class="admin-content">
        <header class="admin-topbar">
            <span class="admin-topbar-title">Matrículas</span>
            <section class="admin-topbar-right">
                <span class="admin-topbar-admin">Olá, <strong><%= gymAdmin.nome.split(' ')[0] %></strong></span>
                <a href="/gym-admin/logout" class="btn admin-btn-logout"><i class="fas fa-sign-out-alt"></i> Sair</a>
            </section>
        </header>

        <main class="admin-main">
            <h1 class="admin-page-title">Editar Matrícula</h1>
            <p class="admin-page-subtitle"><%= matricula.aluno_nome %> — <%= matricula.plano_nome %></p>

            <% if (erro) { %>
            <section class="admin-toast" style="position:static;margin-bottom:20px;border-left-color:var(--error)">
                <i class="fas fa-exclamation-circle" style="color:var(--error)"></i> <%= erro %>
            </section>
            <% } %>

            <section class="admin-card" style="max-width:480px">
                <section class="admin-card-body">
                    <section class="admin-form-group">
                        <label>Aluno</label>
                        <input type="text" class="admin-input" value="<%= matricula.aluno_nome %>" disabled>
                    </section>
                    <section class="admin-form-group">
                        <label>Plano</label>
                        <input type="text" class="admin-input" value="<%= matricula.plano_nome %>" disabled>
                    </section>
                    <section class="admin-form-group">
                        <label>Início</label>
                        <input type="text" class="admin-input" value="<%= new Date(matricula.data_inicio).toLocaleDateString('pt-BR') %>" disabled>
                    </section>
                    <section class="admin-form-group">
                        <label>Vencimento</label>
                        <input type="text" class="admin-input" value="<%= new Date(matricula.data_vencimento).toLocaleDateString('pt-BR') %>" disabled>
                    </section>

                    <form method="POST" action="/gym-admin/matriculas/<%= matricula.id %>">
                        <section class="admin-form-group">
                            <label>Status *</label>
                            <select name="status" class="admin-select-lg">
                                <option value="ativa"     <%= matricula.status === 'ativa'     ? 'selected' : '' %>>Ativa</option>
                                <option value="vencida"   <%= matricula.status === 'vencida'   ? 'selected' : '' %>>Vencida</option>
                                <option value="cancelada" <%= matricula.status === 'cancelada' ? 'selected' : '' %>>Cancelada</option>
                            </select>
                        </section>
                        <section style="display:flex;gap:10px">
                            <button type="submit" class="btn btn-gold" style="flex:1;justify-content:center">
                                <i class="fas fa-save"></i> Salvar status
                            </button>
                            <a href="/gym-admin/matriculas" class="btn btn-outline">Cancelar</a>
                        </section>
                    </form>
                </section>
            </section>
        </main>
    </section>
</section>
</body>
</html>
