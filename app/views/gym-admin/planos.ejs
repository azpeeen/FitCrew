<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Planos — Portal da Academia · FitCrew</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" href="/images/favicon.ico">
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
<section class="admin-wrapper">
    <%- include('./_sidebar') %>
    <section class="admin-content">
        <header class="admin-topbar">
            <span class="admin-topbar-title">Planos</span>
            <section class="admin-topbar-right">
                <span class="admin-topbar-admin">Olá, <strong><%= gymAdmin.nome.split(' ')[0] %></strong></span>
                <a href="/gym-admin/logout" class="btn admin-btn-logout"><i class="fas fa-sign-out-alt"></i> Sair</a>
            </section>
        </header>

        <main class="admin-main">
            <section class="admin-toolbar">
                <section>
                    <h1 class="admin-page-title">Planos</h1>
                    <p class="admin-page-subtitle">Planos de mensalidade de <%= gymAdmin.gym_nome %></p>
                </section>
                <a href="/gym-admin/planos/novo" class="btn btn-gold" style="margin-left:auto">
                    <i class="fas fa-plus"></i> Novo Plano
                </a>
            </section>

            <section class="admin-card">
                <section class="admin-card-body no-pad">
                    <section class="admin-table-wrap">
                        <% if (planos.length === 0) { %>
                        <section style="text-align:center;padding:40px;color:var(--text-muted)">
                            <i class="fas fa-tags" style="font-size:2rem;opacity:.2;display:block;margin-bottom:10px"></i>
                            Nenhum plano cadastrado ainda.
                        </section>
                        <% } else { %>
                        <table class="admin-table">
                            <thead>
                                <tr><th>Nome</th><th>Duração</th><th>Preço</th><th>Status</th><th></th></tr>
                            </thead>
                            <tbody>
                            <% planos.forEach(p => { %>
                            <tr>
                                <td class="fw-600"><%= p.nome %></td>
                                <td class="text-muted"><%= p.duracao_dias %> dia<%= p.duracao_dias !== 1 ? 's' : '' %></td>
                                <td class="text-muted">R$ <%= Number(p.preco).toFixed(2).replace('.', ',') %></td>
                                <td>
                                    <span class="badge <%= p.ativo ? 'badge-success' : 'badge-muted' %>"><%= p.ativo ? 'ativo' : 'inativo' %></span>
                                </td>
                                <td>
                                    <section style="display:flex;gap:6px">
                                        <a href="/gym-admin/planos/<%= p.id %>/editar" class="btn btn-outline btn-sm">Editar</a>
                                        <form method="POST" action="/gym-admin/planos/<%= p.id %>/toggle" style="display:contents">
                                            <button type="submit" class="btn btn-outline btn-sm">
                                                <%= p.ativo ? 'Desativar' : 'Ativar' %>
                                            </button>
                                        </form>
                                    </section>
                                </td>
                            </tr>
                            <% }) %>
                            </tbody>
                        </table>
                        <% } %>
                    </section>
                </section>
            </section>
        </main>
    </section>
</section>
</body>
</html>
