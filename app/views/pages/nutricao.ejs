let _barcodeProduto = null;
let _html5QrScanner = null;

document.getElementById('nutri-btn-barcode')?.addEventListener('click', () => {
    document.getElementById('modal-barcode').classList.add('open');
    document.getElementById('barcode-resultado').style.display = 'none';
    document.getElementById('barcode-erro').style.display = 'none';
    document.getElementById('barcode-input').value = '';
