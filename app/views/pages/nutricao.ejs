<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<%- include('../partials/seo') %>
<link rel="icon" type="image/x-icon" href="/images/favicon.ico">
<link rel="stylesheet" href="/css/header.css">
<link rel="stylesheet" href="/css/footer.css">
<link rel="stylesheet" href="/css/area-aluno.css">
<link rel="stylesheet" href="/css/nutricao.css">
</head>
<body>

<%- include('../partials/header-aluno') %>

<%
const diasSemana = ['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'];
const tiposRefeicao = [
    { key: 'cafe',   label: 'Café da manhã', icon: 'fa-mug-hot' },
    { key: 'almoco', label: 'Almoço',        icon: 'fa-bowl-food' },
    { key: 'jantar', label: 'Jantar',         icon: 'fa-moon' },
    { key: 'lanche', label: 'Lanche',         icon: 'fa-apple-whole' },
    { key: 'outro',  label: 'Outro',          icon: 'fa-utensils' },
];
const kcalRingCircum  = 314;
const kcalPct         = Math.min(1, metas.kcal > 0 ? totaisHoje.kcal / metas.kcal : 0);
const kcalDashOffset  = Math.round(kcalRingCircum * (1 - kcalPct));
const kcalPctDisplay  = Math.min(100, Math.round(kcalPct * 100));
const macros = [
    { key: 'proteina', label: 'Proteína',    atual: totaisHoje.proteina, meta: metas.proteina, unit: 'g',  cor: '#FFD700' },
    { key: 'carbs',    label: 'Carboidrato', atual: totaisHoje.carbs,    meta: metas.carbs,    unit: 'g',  cor: '#4fc3f7' },
    { key: 'gordura',  label: 'Gordura',     atual: totaisHoje.gordura,  meta: metas.gordura,  unit: 'g',  cor: '#ff9800' },
    { key: 'fibra',    label: 'Fibra',       atual: totaisHoje.fibra,    meta: metas.fibra,    unit: 'g',  cor: '#66bb6a' },
];
%>

<section class="aluno-dashboard">
    <section class="sidebar-overlay" id="sidebarOverlay"></section>

    <!-- SIDEBAR -->
    <section class="aluno-sidebar">
        <section class="aluno-profile">
            <section class="avatar">
                <img id="sidebar-avatar" src="<%= user.profile_photo || '/images/avatar.png' %>" alt="Avatar">
            </section>
            <h2><%= user.nome %></h2>
            <p data-translate="sidebar.role">Aluno FitCrew</p>
        </section>
        <ul class="aluno-menu">
            <li class="menu-section-label">Principal</li>
            <li><a href="/feed"><i class="fas fa-home"></i> Feed</a></li>
            <li><a href="/metricas"><i class="fas fa-tachometer-alt"></i> Minhas Métricas</a></li>

            <li class="menu-section-label">Social</li>
            <li><a href="/amizades"><i class="fas fa-user-friends"></i> Amigos</a></li>
            <li><a href="/chat"><i class="fas fa-comment"></i> Mensagens</a></li>
            <li><a href="/buscar"><i class="fas fa-search"></i> Buscar pessoas</a></li>
            <li><a href="/gymsquads"><i class="fas fa-medal"></i> GymSquads</a></li>

            <li class="menu-section-label">Treino</li>
            <li><a href="/treinos" data-translate="sidebar.treinos"><i class="fas fa-dumbbell"></i> Meus Treinos</a></li>
            <li><a href="/evolucao" data-translate="sidebar.evolucao"><i class="fas fa-chart-line"></i> Evolução</a></li>

            <li class="menu-section-label">Saúde</li>
            <li><a href="/nutricao" class="active" data-translate="sidebar.nutricao"><i class="fas fa-utensils"></i> Nutrição</a></li>
            <li><a href="/imc-form"><i class="fas fa-clipboard-list"></i> Medidas</a></li>

            <li class="menu-section-label">IA</li>
            <% if (user && (user.planoSlug === 'gymbro' || user.planoSlug === 'black')) { %>
            <li><a href="/ai/chat" data-translate="sidebar.ai"><i class="fas fa-robot"></i> Personal Trainer IA</a></li>
            <% } else { %>
            <li><a href="/meu-plano?upgrade=1" class="menu-locked" data-translate="sidebar.ai"><i class="fas fa-robot"></i> Personal Trainer IA 🔒</a></li>
            <% } %>
            <% if (user && user.planoSlug === 'black') { %>
            <li><a href="/ai/avaliacao" data-translate="sidebar.avaliacao"><i class="fas fa-camera"></i> Avaliação Corporal</a></li>
            <% } else { %>
            <li><a href="/meu-plano?upgrade=1" class="menu-locked" data-translate="sidebar.avaliacao"><i class="fas fa-camera"></i> Avaliação Corporal 🔒</a></li>
            <% } %>

            <li class="menu-section-label">Academia</li>
            <li class="sidebar-scan-item"><a href="/scan"><i class="fas fa-qrcode"></i> Check-in / Scan</a></li>
            <li><a href="/suporte" data-translate="sidebar.suporte"><i class="fas fa-headset"></i> Suporte</a></li>

            <li class="menu-section-label">Conta</li>
            <li><a href="/perfil/<%= user.username || user.id %>"><i class="fas fa-user-circle"></i> Meu Perfil</a></li>
            <li><a href="/conquistas" data-translate="sidebar.conquistas"><i class="fas fa-trophy"></i> Conquistas</a></li>
            <li><a href="/meu-plano" data-translate="sidebar.plano"><i class="fas fa-file-alt"></i> Meu Plano</a></li>
            <li><a href="/config" data-translate="sidebar.config"><i class="fas fa-cog"></i> Configurações</a></li>
            <li>
                <button class="sidebar-logout-btn" type="button">
                    <i class="fas fa-sign-out-alt"></i> Sair da conta
                </button>
            </li>
        </ul>
    </section>

    <!-- CONTEÚDO PRINCIPAL -->
    <section class="aluno-main">
        <section class="dashboard-top">
            <h1><i class="fas fa-utensils"></i> Nutrição</h1>
            <p>Calorias, macros e hidratação do dia</p>
        </section>

        <% if (!imc) { %>
        <section class="nutri-aviso">
            <i class="fas fa-exclamation-circle"></i>
            Preencha seu <a href="/imc-form">Perfil IMC</a> para receber metas personalizadas de nutrição.
        </section>
        <% } %>

        <!-- 1. HERO CARD -->
        <section class="nutri-hero">
            <section class="nutri-hero-left">
                <section class="nutri-objetivo-seletor">
                    <button class="nutri-obj-btn<%= objetivoAtual === 'cutting'   ? ' active' : '' %>" data-objetivo="cutting"   type="button">Cutting</button>
                    <button class="nutri-obj-btn<%= objetivoAtual === 'manutencao'? ' active' : '' %>" data-objetivo="manutencao" type="button">Manutenção</button>
                    <button class="nutri-obj-btn<%= objetivoAtual === 'bulking'   ? ' active' : '' %>" data-objetivo="bulking"   type="button">Bulking</button>
                </section>
                <h2 class="nutri-hero-title">
                    <span id="kcalRestantes"><%= Math.max(0, metas.kcal - totaisHoje.kcal) %></span>
                    <small>kcal restantes</small>
                </h2>
                <p class="nutri-hero-sub" id="heroSub">
                    <%= totaisHoje.kcal %> consumidas · <%= metas.kcal %> meta
                </p>
            </section>
            <section class="nutri-hero-right">
                <svg class="nutri-ring" viewBox="0 0 120 120">
                    <circle cx="60" cy="60" r="50" fill="none" stroke="#2a2a2a" stroke-width="10"/>
                    <circle cx="60" cy="60" r="50" fill="none"
                            stroke="<%= totaisHoje.kcal > metas.kcal ? '#e74c3c' : '#FFD700' %>"
                            stroke-width="10"
                            stroke-dasharray="314"
                            stroke-dashoffset="<%= kcalDashOffset %>"
                            stroke-linecap="round"
                            transform="rotate(-90 60 60)"
                            id="kcalRingCircle"/>
                    <text x="60" y="55" text-anchor="middle" fill="#FFD700" font-size="18" font-weight="800" id="kcalRingPct">
                        <%= kcalPctDisplay %>%
                    </text>
                    <text x="60" y="72" text-anchor="middle" fill="#888" font-size="9">de kcal</text>
                </svg>
            </section>
        </section>

        <!-- 2. FAIXA DE MACROS -->
        <section class="nutri-macros">
            <% macros.forEach(m => { %>
            <% const pct = Math.min(100, m.meta > 0 ? Math.round((m.atual / m.meta) * 100) : 0); %>
            <section class="nutri-macro-bar">
                <section class="nutri-macro-top">
                    <span class="nutri-macro-label"><%= m.label %></span>
                    <span class="nutri-macro-vals">
                        <strong id="macro-<%= m.key %>-atual"><%= parseFloat(m.atual).toFixed(1) %></strong>
                        / <%= m.meta %><%= m.unit %>
                    </span>
                </section>
                <section class="nutri-bar-track">
                    <section class="nutri-bar-fill" id="macro-<%= m.key %>-fill"
                        style="width:<%= pct %>%; background:<%= pct >= 100 ? '#e74c3c' : m.cor %>">
                    </section>
                </section>
                <span class="nutri-macro-falta" id="macro-<%= m.key %>-falta">
                    <%= m.atual >= m.meta ? '✓ meta atingida' : `faltam ${(m.meta - m.atual).toFixed(1)}${m.unit}` %>
                </span>
            </section>
            <% }) %>
        </section>

        <!-- 3. ÁGUA -->
        <section class="nutri-agua-card">
            <section class="nutri-agua-row">
                <section class="nutri-agua-left">
                    <i class="fas fa-droplet" style="color:#4fc3f7;font-size:1.1rem"></i>
                    <span class="nutri-agua-label">Água</span>
                    <section class="nutri-agua-vals">
                        <strong id="aguaAtual">0</strong>
                        <small>/ <%= (metas.agua/1000).toFixed(1) %>L</small>
                    </section>
                </section>
                <section class="nutri-agua-right">
                    <button class="nutri-agua-btn" data-agua="menos" type="button">−</button>
                    <section class="nutri-agua-centro">
                        <span id="aguaCopos">0 registros</span>
                        <select id="aguaVolumeSelect" class="nutri-agua-select">
                            <option value="150">150ml</option>
                            <option value="200">200ml</option>
                            <option value="250" selected>250ml</option>
                            <option value="300">300ml</option>
                            <option value="350">350ml</option>
                            <option value="400">400ml</option>
                            <option value="500">500ml</option>
                            <option value="600">600ml</option>
                            <option value="750">750ml</option>
                            <option value="1000">1L</option>
                        </select>
                    </section>
                    <button class="nutri-agua-btn" data-agua="mais" type="button">+</button>
                </section>
            </section>
            <section class="nutri-bar-track" style="margin-top:8px">
                <section class="nutri-bar-fill" id="aguaFill" style="background:#4fc3f7;width:0%"></section>
            </section>
        </section>

        <!-- 4. INSIGHT CARD -->
        <section class="nutri-insight-card" id="nutri-insight">
            <i class="fas fa-circle-check" style="color:#22c55e"></i>
            <span>Carregando insight...</span>
        </section>

        <!-- 5. TIMELINE DE REFEIÇÕES -->
        <% tiposRefeicao.forEach(tipo => { %>
        <% const logsDoTipo = registrosHoje.filter(r => r.refeicao_tipo === tipo.key); %>
        <% const totalTipo = logsDoTipo.reduce((a, r) => a + (Number(r.kcal) || 0), 0); %>
        <%
        // Verifica se há algum item (novo formato) ou log legado
        let temItensParaMostrar = false;
        for (const r of logsDoTipo) {
            if ((r.itens && r.itens.length > 0 && r.itens.some(i => i.id)) || (!r.itens || r.itens.length === 0)) {
                temItensParaMostrar = true; break;
            }
        }
        %>
        <section class="nutri-refeicao-grupo">
            <section class="nutri-refeicao-header" data-refeicao-key="<%= tipo.key %>">
                <section class="nutri-refeicao-left">
                    <i class="fas <%= tipo.icon %>"></i>
                    <span><%= tipo.label %></span>
                </section>
                <section class="nutri-refeicao-right">
                    <span class="nutri-refeicao-kcal" id="kcal-tipo-<%= tipo.key %>"><%= totalTipo %> kcal</span>
                    <button class="nutri-add-btn" data-add-key="<%= tipo.key %>" type="button" title="Adicionar">
                        <i class="fas fa-plus"></i>
                    </button>
                </section>
            </section>
            <section class="nutri-refeicao-itens" id="refeicao-<%= tipo.key %>">
                <% if (logsDoTipo.length === 0) { %>
                <p class="nutri-refeicao-vazio">Nenhum item registrado</p>
                <% } else { %>
                <%
                let contadorItens = 0;
                logsDoTipo.forEach(r => {
                    const temItensNovos = r.itens && r.itens.length > 0 && r.itens.some(i => i.id);
                    if (temItensNovos) {
                        r.itens.filter(i => i.id).forEach(item => {
                            contadorItens++;
                %>
                <section class="nutri-item-linha" id="nutri-item-i-<%= item.id %>">
                    <section class="nutri-item-info">
                        <section class="nutri-item-texto">
                            <span class="nutri-item-nome"><%= item.nome %></span>
                            <span class="nutri-item-hora"><%= item.quantidade_g %>g<% if (item.fonte && item.fonte !== 'manual') { %> · <span class="nutri-fonte-badge nutri-fonte-<%= item.fonte %>"><%= item.fonte === 'usda' ? 'USDA' : item.fonte === 'openfoodfacts' ? 'OpenFF' : 'IA' %></span><% } %></span>
                        </section>
                    </section>
                    <span class="nutri-item-macros">
                        <%= Math.round(item.kcal) %> kcal<% if (Number(item.proteina_g) > 0) { %> · P:<%= parseFloat(item.proteina_g).toFixed(0) %>g<% } %>
                    </span>
                    <button class="nutri-item-del" data-del-item data-item-id="<%= item.id %>" data-reg-id="<%= r.id %>" data-tipo-key="<%= tipo.key %>" data-kcal="<%= item.kcal||0 %>" data-prot="<%= item.proteina_g||0 %>" data-carbs="<%= item.carbs_g||0 %>" data-gord="<%= item.gordura_g||0 %>" data-fibra="<%= item.fibra_g||0 %>" type="button" title="Excluir">
                        <i class="fas fa-trash"></i>
                    </button>
                </section>
                <%
                        });
                    } else {
                        // Formato legado — log sem itens
                        contadorItens++;
                        const horaFormatada = r.horario ? String(r.horario).slice(0,5) : null;
                %>
                <section class="nutri-item-linha" id="nutri-item-<%= r.id %>">
                    <section class="nutri-item-info">
                        <% if (r.foto_url) { %><img src="<%= r.foto_url %>" class="nutri-item-foto" alt=""><% } %>
                        <section class="nutri-item-texto">
                            <span class="nutri-item-nome"><%= r.refeicao %></span>
                            <% if (horaFormatada) { %><span class="nutri-item-hora"><%= horaFormatada %></span><% } %>
                        </section>
                    </section>
                    <span class="nutri-item-macros">
                        <%= r.kcal %> kcal<% if (Number(r.proteina_g) > 0) { %> · P:<%= parseFloat(r.proteina_g).toFixed(0) %>g<% } %>
                    </span>
                    <button class="nutri-item-del" data-del-reg data-reg-id="<%= r.id %>" data-tipo-key="<%= tipo.key %>" data-kcal="<%= r.kcal %>" data-prot="<%= r.proteina_g||0 %>" data-carbs="<%= r.carbs_g||0 %>" data-gord="<%= r.gordura_g||0 %>" data-fibra="<%= r.fibra_g||0 %>" type="button" title="Excluir">
                        <i class="fas fa-trash"></i>
                    </button>
                </section>
                <%
                    }
                });
                if (contadorItens === 0) {
                %>
                <p class="nutri-refeicao-vazio">Nenhum item registrado</p>
                <% } %>
                <% } %>
            </section>
        </section>
        <% }) %>

        <!-- 6. ADERÊNCIA SEMANAL -->
        <section class="nutri-aderencia">
            <section class="nutri-card-title"><i class="fas fa-calendar-week"></i> Aderência esta semana</section>
            <section class="nutri-aderencia-grid">
                <% aderenciaSemanal.forEach(d => { %>
                <%
                const diaSem  = diasSemana[new Date(String(d.data) + 'T12:00:00').getDay()];
                const pctAder = Math.min(100, metas.kcal > 0 ? Math.round((Number(d.total_kcal) / metas.kcal) * 100) : 0);
                const aderClass = pctAder === 0 ? 'ader-zero' : pctAder < 70 ? 'ader-low' : pctAder > 115 ? 'ader-over' : 'ader-ok';
                %>
                <section class="nutri-ader-dia <%= aderClass %>">
                    <section class="nutri-ader-bar" style="height:<%= pctAder %>%"></section>
                    <span class="nutri-ader-label"><%= diaSem %></span>
                    <span class="nutri-ader-pct"><%= pctAder %>%</span>
                </section>
                <% }) %>
            </section>
            <section class="nutri-aderencia-legend">
                <span><span class="ader-ok-dot"></span>Meta atingida</span>
                <span><span class="ader-low-dot"></span>Abaixo</span>
                <span><span class="ader-over-dot"></span>Acima</span>
            </section>
        </section>

        <!-- 7. HISTÓRICO DE REFEIÇÕES -->
        <section class="nutri-card" id="nutri-historico-section">
            <section class="nutri-card-title">
                <i class="fas fa-clock-rotate-left"></i> Histórico de Refeições
            </section>
            <section id="nutri-historico-lista">
                <p style="color:#555; font-size:.85rem; text-align:center; padding:20px;">
                    <i class="fas fa-circle-notch fa-spin"></i> Carregando...
                </p>
            </section>
            <section id="nutri-historico-paginacao" style="text-align:center; margin-top:16px;"></section>
        </section>

    </section><!-- /aluno-main -->
</section><!-- /aluno-dashboard -->

<!-- MODAL DE BUSCA DE ALIMENTOS (bottom sheet) -->
<section class="nutri-form-modal" id="nutri-form-modal">
    <section class="nutri-form-inner">
        <section class="nutri-form-header">
            <h3 id="nutri-form-titulo">Adicionar alimento</h3>
            <button class="nutri-form-close" type="button"><i class="fas fa-times"></i></button>
        </section>

        <!-- Busca de alimentos -->
        <section class="nutri-busca-wrapper" id="nutri-busca-wrapper">
            <section class="nutri-busca-input-row">
                <input type="text" id="nutri-busca-input" class="nutri-input"
                       placeholder="Buscar alimento... (ex: frango, arroz, banana)"
                       autocomplete="off">
                <button class="nutri-btn-foto" id="nutri-foto-btn" type="button" title="Analisar foto com IA">
                    <i class="fas fa-camera"></i>
                </button>
                <button class="nutri-btn-barcode" id="nutri-btn-barcode" type="button" title="Ler código de barras">
                    <i class="fas fa-barcode"></i>
                </button>
            </section>
            <section id="nutri-busca-resultados" class="nutri-busca-resultados"></section>
        </section>

        <!-- Alimento selecionado + quantidade -->
        <section id="nutri-alimento-selecionado" style="display:none">
            <section class="nutri-alimento-card" id="nutri-alimento-info"></section>
            <section class="nutri-quantidade-row">
                <section id="nutri-quantidade-wrapper" style="flex:1">
                    <!-- Preenchido dinamicamente pelo JS conforme o alimento -->
                </section>
                <section class="nutri-macros-preview" id="nutri-macros-preview"></section>
            </section>
            <button class="nutri-btn-salvar" id="nutri-add-item-btn" type="button">
                <i class="fas fa-plus"></i> Adicionar à refeição
            </button>
            <button class="nutri-btn-voltar" type="button">
                <i class="fas fa-arrow-left"></i> Buscar outro alimento
            </button>
        </section>

        <!-- Lista de itens adicionados na sessão atual -->
        <section id="nutri-itens-sessao" class="nutri-itens-sessao" style="display:none">
            <h4 class="nutri-itens-titulo">Adicionados nesta refeição</h4>
            <section id="nutri-itens-lista"></section>
            <section class="nutri-itens-total" id="nutri-itens-total"></section>
            <button class="nutri-btn-concluir" type="button">
                <i class="fas fa-check"></i> Concluir refeição
            </button>
        </section>
    </section>
</section>
<section class="nutri-modal-overlay" id="nutri-overlay"></section>

<!-- MODAL: análise de foto com IA -->
<section id="modal-ia-foto" class="modal-overlay">
    <section class="modal-box modal-ia-box">

        <section class="modal-header">
            <h3><i class="fas fa-camera"></i> Analisar foto com IA</h3>
            <button type="button" class="modal-close" id="modal-ia-fechar"><i class="fas fa-times"></i></button>
        </section>

        <!-- Step 1: seleção de foto -->
        <section id="ia-step-foto" class="ia-step">
            <section class="ia-foto-area" id="ia-foto-area">
                <i class="fas fa-camera ia-foto-icon"></i>
                <p>Tire uma foto ou escolha da galeria</p>
                <section class="ia-foto-btns">
                    <button type="button" class="ia-btn-secundario" id="ia-btn-galeria">
                        <i class="fas fa-images"></i> Galeria
                    </button>
                    <button type="button" class="ia-btn-primario" id="ia-btn-camera">
                        <i class="fas fa-camera"></i> Câmera
                    </button>
                </section>
                <input type="file" id="ia-input-galeria" accept="image/*" style="display:none">
                <input type="file" id="ia-input-camera" accept="image/*" capture="environment" style="display:none">
            </section>

            <section id="ia-foto-preview-wrap" style="display:none">
                <img id="ia-foto-preview" src="" class="ia-foto-preview-img" alt="">
                <button type="button" class="ia-btn-link" id="ia-btn-trocar-foto">Trocar foto</button>
            </section>

            <button type="button" class="ia-btn-primario ia-btn-full" id="ia-btn-analisar" style="display:none" disabled>
                <i class="fas fa-magic"></i> Analisar com IA
            </button>
        </section>

        <!-- Step 2: resultado da análise -->
        <section id="ia-step-resultado" class="ia-step" style="display:none">
            <section class="ia-resultado-header">
                <img id="ia-resultado-foto" src="" class="ia-resultado-miniatura" alt="">
                <section>
                    <section class="ia-resultado-titulo">Encontramos isso:</section>
                    <section class="ia-resultado-obs" id="ia-resultado-obs"></section>
                </section>
            </section>

            <section id="ia-alimentos-lista" class="ia-alimentos-lista"></section>

            <section class="ia-resultado-acoes">
                <button type="button" class="ia-btn-secundario" id="ia-btn-refazer">
                    <i class="fas fa-redo"></i> Tirar outra foto
                </button>
                <button type="button" class="ia-btn-primario" id="ia-btn-confirmar">
                    Confirmar e adicionar
                </button>
            </section>
        </section>

        <!-- Step 3: pesos -->
        <section id="ia-step-pesos" class="ia-step" style="display:none">
            <section class="ia-pesos-titulo">Informe as quantidades:</section>
            <section id="ia-pesos-lista" class="ia-pesos-lista"></section>
            <button type="button" class="ia-btn-primario ia-btn-full" id="ia-btn-salvar-ia">
