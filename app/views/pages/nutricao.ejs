<%- include('../partials/footer') %>
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"
    integrity="sha384-c9d8RFSL+u3exBOJ4Yp3HUJXS4znl9f+z66d1y54ig+ea249SpqR+w1wyvXz/lk+"
    crossorigin="anonymous"></script>
<script>
window._METAS = <%- JSON.stringify(metas) %>;
window._TOTAIS_HOJE = <%- JSON.stringify(totaisHoje) %>;
</script>
<script>
'use strict';

const _METAS  = window._METAS;
const _totais = { ...window._TOTAIS_HOJE };

// ── Wiring de eventos (sem on* inline — CSP) ─────────────────────────────────
document.getElementById('aguaVolumeSelect')?.addEventListener('change', () => salvarVolume());
document.addEventListener('click', function (e) {
    const objBtn = e.target.closest('.nutri-obj-btn[data-objetivo]');
    if (objBtn) { setObjetivo(objBtn.dataset.objetivo); return; }

    const aguaBtn = e.target.closest('.nutri-agua-btn[data-agua]');
    if (aguaBtn) { const v = aguaVolume(); ajustarAgua(aguaBtn.dataset.agua === 'menos' ? -v : v); return; }

    const addBtn = e.target.closest('.nutri-add-btn[data-add-key]');
    if (addBtn) { abrirForm(addBtn.dataset.addKey); return; }

    const header = e.target.closest('.nutri-refeicao-header[data-refeicao-key]');
    if (header) { toggleRefeicao(header.dataset.refeicaoKey); return; }

    const delItem = e.target.closest('.nutri-item-del[data-del-item]');
    if (delItem) { const d = delItem.dataset; deletarItem(Number(d.itemId), Number(d.regId), d.tipoKey, Number(d.kcal), Number(d.prot), Number(d.carbs), Number(d.gord), Number(d.fibra)); return; }

    const delReg = e.target.closest('.nutri-item-del[data-del-reg]');
    if (delReg) { const d = delReg.dataset; deletarRegistro(Number(d.regId), d.tipoKey, Number(d.kcal), Number(d.prot), Number(d.carbs), Number(d.gord), Number(d.fibra)); return; }

    if (e.target.closest('.nutri-form-close') || e.target.closest('.nutri-btn-concluir')) { fecharForm(); return; }
    if (e.target.closest('.nutri-btn-voltar')) { voltarBusca(); return; }
    if (e.target.id === 'nutri-overlay') { fecharForm(); return; }

    const buscaItem = e.target.closest('.nutri-busca-item[data-index]');
    if (buscaItem) { selecionarAlimento(Number(buscaItem.dataset.index)); return; }
});

// ── XSS helper ────────────────────────────────────────
function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

// ── Ring SVG ──────────────────────────────────────────
function atualizarRing(kcalAtual) {
    const meta   = _METAS.kcal;
    const pct    = Math.min(1, meta > 0 ? kcalAtual / meta : 0);
    const offset = Math.round(314 * (1 - pct));
    const circle = document.getElementById('kcalRingCircle');
    const pctEl  = document.getElementById('kcalRingPct');
    const restEl = document.getElementById('kcalRestantes');
    const subEl  = document.getElementById('heroSub');
    if (circle) {
        circle.setAttribute('stroke-dashoffset', offset);
        circle.setAttribute('stroke', kcalAtual > meta ? '#e74c3c' : '#FFD700');
    }
    if (pctEl)  pctEl.textContent  = Math.min(100, Math.round(pct * 100)) + '%';
    if (restEl) restEl.textContent = Math.max(0, meta - kcalAtual);
    if (subEl)  subEl.textContent  = `${kcalAtual} consumidas · ${meta} meta`;
}

// ── Barras de macro ───────────────────────────────────
const _macroConfig = {
    proteina: { meta: _METAS.proteina, unit: 'g', cor: '#FFD700' },
    carbs:    { meta: _METAS.carbs,    unit: 'g', cor: '#4fc3f7' },
    gordura:  { meta: _METAS.gordura,  unit: 'g', cor: '#ff9800' },
    fibra:    { meta: _METAS.fibra,    unit: 'g', cor: '#66bb6a' },
};

function atualizarMacroBar(key, valor) {
    const cfg  = _macroConfig[key];
    if (!cfg) return;
    const pct  = Math.min(100, cfg.meta > 0 ? Math.round((valor / cfg.meta) * 100) : 0);
    const fill = document.getElementById(`macro-${key}-fill`);
    const num  = document.getElementById(`macro-${key}-atual`);
    const msg  = document.getElementById(`macro-${key}-falta`);
    if (fill) { fill.style.width = pct + '%'; fill.style.background = pct >= 100 ? '#e74c3c' : cfg.cor; }
    if (num)  num.textContent  = parseFloat(valor).toFixed(1);
    if (msg)  msg.textContent  = valor >= cfg.meta ? '✓ meta atingida' : `faltam ${(cfg.meta - valor).toFixed(1)}${cfg.unit}`;
}

// ── Insight ───────────────────────────────────────────
function gerarInsight() {
    const faltaKcal  = Math.max(0, _METAS.kcal      - _totais.kcal);
    const faltaProt  = Math.max(0, _METAS.proteina  - _totais.proteina);
    const faltaFibra = Math.max(0, _METAS.fibra     - _totais.fibra);
    const msgs = [];
    if (faltaProt  > 10)  msgs.push(`faltam <strong>${faltaProt.toFixed(0)}g de proteína</strong>`);
    if (faltaFibra >  5)  msgs.push(`faltam <strong>${faltaFibra.toFixed(0)}g de fibra</strong>`);
    if (faltaKcal  > 200) msgs.push(`faltam <strong>${faltaKcal} kcal</strong> para a meta`);
    if (_totais.kcal > _METAS.kcal) msgs.push(`você passou <strong>${_totais.kcal - _METAS.kcal} kcal</strong> da meta hoje`);
    const el = document.getElementById('nutri-insight');
    if (!el) return;
    if (msgs.length === 0) {
        el.innerHTML = '<i class="fas fa-circle-check" style="color:#22c55e"></i> <span>Tudo certo! Metas do dia em ordem.</span>';
    } else {
        el.innerHTML = `<i class="fas fa-lightbulb"></i> <span>${msgs.join(' · ')}</span>`;
    }
}

// ── Atualizar totais (após add/delete) ────────────────
function atualizarTotais(dKcal, dProt, dCarbs, dGord, dFibra) {
    _totais.kcal     = Math.max(0, _totais.kcal     + dKcal);
    _totais.proteina = Math.max(0, _totais.proteina + dProt);
    _totais.carbs    = Math.max(0, _totais.carbs    + dCarbs);
    _totais.gordura  = Math.max(0, _totais.gordura  + dGord);
    _totais.fibra    = Math.max(0, _totais.fibra    + dFibra);
    atualizarRing(_totais.kcal);
    Object.keys(_macroConfig).forEach(k => atualizarMacroBar(k, _totais[k]));
    gerarInsight();
}

// ── Água (localStorage) ───────────────────────────────
const AGUA_KEY     = 'gymbros_agua_' + new Date().toLocaleDateString('en-CA');
const AGUA_VOL_KEY = 'gymbros_agua_vol';

function aguaVolume() {
    return parseInt(document.getElementById('aguaVolumeSelect').value) || 250;
}
function salvarVolume() {
    localStorage.setItem(AGUA_VOL_KEY, aguaVolume());
    updateAguaUI();
}
function getAgua() {
    return parseInt(localStorage.getItem(AGUA_KEY) || '0');
}
function ajustarAgua(delta) {
    const novo = Math.max(0, getAgua() + delta);
    localStorage.setItem(AGUA_KEY, novo);
    updateAguaUI();
}
function updateAguaUI() {
    const ml   = getAgua();
    const meta = _METAS.agua;
    const pct  = Math.min(100, meta > 0 ? Math.round((ml / meta) * 100) : 0);
    const vol  = aguaVolume();
    const qtd  = Math.round(ml / vol);
    const litros = (ml / 1000).toFixed(2).replace(/\.?0+$/, '') + 'L';
    const elAtual = document.getElementById('aguaAtual');
    const elFill  = document.getElementById('aguaFill');
    const elCopos = document.getElementById('aguaCopos');
    if (elAtual) elAtual.textContent = litros;
    if (elFill)  elFill.style.width  = pct + '%';
    if (elCopos) elCopos.textContent = qtd === 0 ? '0 registros' : `${qtd} × ${vol}ml`;
}

// ── Toggle seção de refeição ──────────────────────────
function toggleRefeicao(tipo) {
    const el = document.getElementById(`refeicao-${tipo}`);
    if (el) el.style.display = el.style.display === 'none' ? '' : 'none';
}

// ── Kcal por tipo ─────────────────────────────────────
const _kcalPorTipo = {};
function atualizarKcalTipo(tipo, delta) {
    _kcalPorTipo[tipo] = (_kcalPorTipo[tipo] || 0) + delta;
    const el = document.getElementById(`kcal-tipo-${tipo}`);
    if (el) el.textContent = `${Math.max(0, _kcalPorTipo[tipo])} kcal`;
}

// ── Deletar registro legado ───────────────────────────
async function deletarRegistro(id, tipo, kcal, prot, carbs, gord, fibra) {
    const el = document.getElementById(`nutri-item-${id}`);
    if (!el) return;
    el.style.cssText = 'opacity:0;transform:translateX(20px);transition:opacity .2s,transform .2s;';
    try {
        const res  = await fetch(`/api/nutricao/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.ok) {
            setTimeout(() => {
                el.remove();
                atualizarTotais(-kcal, -prot, -carbs, -gord, -fibra);
                atualizarKcalTipo(tipo, -kcal);
                const container = document.getElementById(`refeicao-${tipo}`);
                if (container && !container.querySelector('.nutri-item-linha')) {
                    container.innerHTML = '<p class="nutri-refeicao-vazio">Nenhum item registrado</p>';
                }
            }, 200);
        } else { el.style.cssText = ''; }
    } catch (_) { el.style.cssText = ''; }
}

// ── Deletar item do novo sistema ──────────────────────
async function deletarItem(itemId, logId, tipo, kcal, prot, carbs, gord, fibra) {
    const el = document.getElementById(`nutri-item-i-${itemId}`);
    if (!el) return;
    el.style.cssText = 'opacity:0;transform:translateX(20px);transition:opacity .2s,transform .2s;';
    try {
        const res  = await fetch(`/api/nutricao/item/${itemId}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.ok) {
            setTimeout(() => {
                el.remove();
                atualizarTotais(-kcal, -prot, -carbs, -gord, -fibra);
                atualizarKcalTipo(tipo, -kcal);
                const container = document.getElementById(`refeicao-${tipo}`);
                if (container && !container.querySelector('.nutri-item-linha')) {
                    container.innerHTML = '<p class="nutri-refeicao-vazio">Nenhum item registrado</p>';
                }
            }, 200);
        } else { el.style.cssText = ''; }
    } catch (_) { el.style.cssText = ''; }
}

// ── Objetivo nutricional ──────────────────────────────
async function setObjetivo(objetivo) {
    document.querySelectorAll('.nutri-obj-btn').forEach(b => b.classList.remove('active'));
    const btn = document.querySelector(`.nutri-obj-btn[onclick*="'${objetivo}'"]`);
    if (btn) btn.classList.add('active');
    try {
        await fetch('/api/nutricao/objetivo', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ objetivo }),
        });
        window.location.reload();
    } catch (_) {}
}

// ═══════════════════════════════════════════════════════
// NOVO MODAL DE BUSCA DE ALIMENTOS
// ═══════════════════════════════════════════════════════

function getLocalDatetime() {
    const now = new Date();
    const data    = now.toLocaleDateString('en-CA');
    const horario = now.toTimeString().slice(0, 8);
    return { data, horario };
}

let _logIdAtual    = null;
let _alimentoAtual = null;
let _itensSessao   = [];
let _searchTimeout = null;
let _tipoAtual     = null;

async function abrirForm(tipo) {
    const modal = document.getElementById('nutri-form-modal');
    // Só resetar contexto se trocar de tipo
    if (modal.dataset.tipo !== tipo) {
        _logIdAtual  = null;
        _itensSessao = [];
    }
    _tipoAtual = tipo;
    modal.dataset.tipo = tipo;
    const labels = { cafe:'Café da manhã', almoco:'Almoço', jantar:'Jantar', lanche:'Lanche', outro:'Outro' };
    document.getElementById('nutri-form-titulo').textContent = labels[tipo] || 'Refeição';
    modal.classList.add('open');
    document.getElementById('nutri-overlay').classList.add('open');
    document.body.style.overflow = 'hidden';
    resetarBusca();
    setTimeout(() => { const el = document.getElementById('nutri-busca-input'); if (el) el.focus(); }, 280);

    if (!_logIdAtual) {
        try {
            const r = await fetch('/api/nutricao/refeicao', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ refeicao_tipo: tipo, ...getLocalDatetime() }),
            });
            const d = await r.json();
            if (d.ok) {
                _logIdAtual = d.log_id;
                const ri = await fetch('/api/nutricao/itens/' + d.log_id);
                const di = await ri.json();
                if (di.itens && di.itens.length) {
                    _itensSessao = di.itens.map(i => ({ ...i, _nome: i.alimento_nome }));
                    atualizarItensSessao();
                }
            }
        } catch (_) {}
    }
}

function fecharForm() {
    document.getElementById('nutri-form-modal').classList.remove('open');
    document.getElementById('nutri-overlay').classList.remove('open');
    document.body.style.overflow = '';
    if (_itensSessao.length > 0) location.reload();
}

function resetarBusca() {
    _alimentoAtual = null;
    const inp = document.getElementById('nutri-busca-input');
    if (inp) inp.value = '';
    document.getElementById('nutri-busca-resultados').innerHTML = '';
    document.getElementById('nutri-alimento-selecionado').style.display = 'none';
    document.getElementById('nutri-busca-wrapper').style.display = 'block';
    atualizarItensSessao();
}

function voltarBusca() {
    _alimentoAtual = null;
    document.getElementById('nutri-alimento-selecionado').style.display = 'none';
    document.getElementById('nutri-busca-wrapper').style.display = 'block';
    // Limpar busca anterior mas manter itens já adicionados na sessão
    const inp = document.getElementById('nutri-busca-input');
    if (inp) inp.value = '';
    document.getElementById('nutri-busca-resultados').innerHTML = '';
    if (inp) inp.focus();
    atualizarItensSessao();
}

let _searchAbortCtrl = null;

// Busca com debounce
document.getElementById('nutri-busca-input').addEventListener('input', function () {
    clearTimeout(_searchTimeout);
    if (_searchAbortCtrl) { _searchAbortCtrl.abort(); _searchAbortCtrl = null; }
    const q = this.value.trim();
    if (q.length < 2) {
        document.getElementById('nutri-busca-resultados').innerHTML = '';
        return;
    }
    document.getElementById('nutri-busca-resultados').innerHTML =
        '<p class="nutri-busca-loading"><i class="fas fa-circle-notch fa-spin"></i> Buscando...</p>';
    _searchTimeout = setTimeout(() => buscarAlimento(q), 400);
});

async function buscarAlimento(q) {
    _searchAbortCtrl = new AbortController();
    const lang = (document.documentElement.lang || 'pt').slice(0, 2);
    try {
        const res  = await fetch(
            '/api/nutricao/buscar?q=' + encodeURIComponent(q) + '&lang=' + lang,
            { signal: _searchAbortCtrl.signal }
        );
        const data = await res.json();
        const el   = document.getElementById('nutri-busca-resultados');
        if (!data.length) {
            el.innerHTML = '<p class="nutri-busca-vazio">Nenhum resultado. Tente outro termo ou use a câmera.</p>';
            return;
        }
        el.innerHTML = data.map((a, i) => `
            <button class="nutri-busca-item" data-index="${i}" type="button">
                <section class="nutri-busca-nome">${esc(a.nome)}</section>
                <section class="nutri-busca-kcal">${Math.round(a.por100g.kcal)} kcal/100g</section>
            </button>
        `).join('');
        el.dataset.resultados = JSON.stringify(data);
    } catch (e) {
        if (e.name === 'AbortError') return;
        document.getElementById('nutri-busca-resultados').innerHTML =
            '<p class="nutri-busca-vazio">Erro na busca.</p>';
    }
}

// ── Alimentos contáveis ───────────────────────────────
const _alimentosContaveis = [
    'egg', 'ovo', 'ovos', 'bread', 'pão', 'pao', 'biscuit', 'bolacha',
    'cookie', 'biscoito', 'cracker', 'wafer', 'tortilla', 'wrap',
    'muffin', 'pancake', 'waffle', 'bagel', 'croissant', 'torrada', 'toast',
];

function isContavel(nomeAlimento) {
    const n = nomeAlimento.toLowerCase();
    return _alimentosContaveis.some(c => n.includes(c));
}

function getPesoUnitario(nome) {
    const n = (nome || '').toLowerCase()
        .normalize('NFD').replace(/[̀-ͯ]/g, '');
    if (n.includes('ovo') || n.includes('egg'))                                                         return 60;
    if (n.includes('pao frances') || n.includes('french bread') || n.includes('pao, frances'))          return 50;
    if (n.includes('pao') || n.includes('bread'))                                                       return 50;
    if (n.includes('bolacha') || n.includes('biscoito') || n.includes('cookie') || n.includes('cracker')) return 10;
    if (n.includes('torrada') || n.includes('toast'))                                                   return 12;
    if (n.includes('omelete'))                                                                          return 60;
    if (n.includes('nugget'))                                                                           return 20;
    if (n.includes('muffin'))                                                                           return 80;
    if (n.includes('bagel'))                                                                            return 100;
    if (n.includes('croissant'))                                                                        return 60;
    return null;
}

function atualizarPreview() {
    if (!_alimentoAtual) return;
    const g = Number(document.getElementById('nutri-quantidade')?.value);
    const el = document.getElementById('nutri-macros-preview');
    if (!el) return;
    if (!g) { el.innerHTML = ''; return; }
    const f = g / 100;
    const a = _alimentoAtual.por100g;
    el.innerHTML = `
        <section class="nutri-preview-grid">
            <section><strong>${Math.round(a.kcal * f)}</strong><small>kcal</small></section>
            <section><strong>${(a.proteina * f).toFixed(1)}g</strong><small>prot</small></section>
            <section><strong>${(a.carbs * f).toFixed(1)}g</strong><small>carbs</small></section>
            <section><strong>${(a.gordura * f).toFixed(1)}g</strong><small>gord</small></section>
        </section>
    `;
}

function renderizarCampoQuantidade() {
    const wrapper     = document.getElementById('nutri-quantidade-wrapper');
    const contavel    = isContavel(_alimentoAtual.nome);
    const pesoUnit    = getPesoUnitario(_alimentoAtual.nome);

    if (contavel) {
        wrapper.innerHTML = `
            <section style="display:flex; gap:10px; margin-bottom:4px;">
                <section style="flex:1">
                    <label class="nutri-label">Unidades</label>
                    <input type="number" id="nutri-unidades" class="nutri-input"
                           placeholder="Ex: 2" min="1" step="1" style="margin-bottom:0">
                </section>
                <section style="flex:1">
                    <label class="nutri-label">ou Gramas (g)</label>
                    <input type="number" id="nutri-quantidade" class="nutri-input"
                           placeholder="Ex: 120" min="1" max="5000" style="margin-bottom:0">
                </section>
            </section>
            <small style="color:#555; font-size:.7rem; display:block; margin-bottom:8px;">
                Preencha unidades${pesoUnit ? ` (1 unid. ≈ ${pesoUnit}g)` : ''} OU gramas — ao menos um é obrigatório
            </small>
        `;
        if (pesoUnit) {
            setTimeout(() => {
                const unEl = document.getElementById('nutri-unidades');
                if (unEl) {
                    unEl.addEventListener('input', function () {
                        const un = Number(this.value);
                        if (un > 0) {
                            const g = Math.round(un * pesoUnit);
                            document.getElementById('nutri-quantidade').value = g;
                            atualizarPreview();
                        }
                    });
                }
            }, 50);
        }
    } else {
        wrapper.innerHTML = `
            <label class="nutri-label">Quantidade (g ou ml) *</label>
            <input type="number" id="nutri-quantidade" class="nutri-input"
                   placeholder="Ex: 300" min="1" max="5000" style="margin-bottom:0">
        `;
    }

    setTimeout(() => {
        const el = document.getElementById('nutri-quantidade');
        if (el) {
            el.addEventListener('input', atualizarPreview);
            el.focus();
        }
    }, 50);
}

function selecionarAlimento(idx) {
    const resultadosRaw = document.getElementById('nutri-busca-resultados').dataset.resultados;
    if (!resultadosRaw) return;
    const resultados = JSON.parse(resultadosRaw);
    if (idx >= 0) _alimentoAtual = resultados[idx];
    if (!_alimentoAtual) return;

    document.getElementById('nutri-busca-wrapper').style.display = 'none';
    document.getElementById('nutri-alimento-selecionado').style.display = 'block';
    document.getElementById('nutri-macros-preview').innerHTML = '';

    const a = _alimentoAtual.por100g;
    document.getElementById('nutri-alimento-info').innerHTML = `
        <section class="nutri-alimento-nome">${esc(_alimentoAtual.nome)}</section>
        <section class="nutri-alimento-meta">
            Por 100g: ${Math.round(a.kcal)} kcal ·
            P: ${a.proteina.toFixed(1)}g ·
            C: ${a.carbs.toFixed(1)}g ·
            G: ${a.gordura.toFixed(1)}g
        </section>
    `;
    renderizarCampoQuantidade();
}

// Adicionar item
document.getElementById('nutri-add-item-btn').addEventListener('click', async () => {
    const inputUnidades = document.getElementById('nutri-unidades');
    const inputGramas   = document.getElementById('nutri-quantidade');
    const tipo = document.getElementById('nutri-form-modal').dataset.tipo;

    let g = Number(inputGramas?.value);

    if ((!g || g <= 0) && inputUnidades) {
        const unidades = Number(inputUnidades.value);
        if (unidades > 0) {
            const pesoUnit = getPesoUnitario(_alimentoAtual?.nome || '');
            if (pesoUnit) {
                g = unidades * pesoUnit;
                if (inputGramas) inputGramas.value = g;
            } else {
                alert('Para este alimento, informe o peso em gramas.');
                inputGramas?.focus();
                return;
            }
        }
    }

    if (!g || g <= 0) { alert('Informe a quantidade em gramas ou o número de unidades.'); return; }
    if (!_alimentoAtual) return;

    const btn = document.getElementById('nutri-add-item-btn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Salvando...';

    try {
        if (!_logIdAtual) {
            const r = await fetch('/api/nutricao/refeicao', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ refeicao_tipo: tipo, ...getLocalDatetime() }),
            });
            const d = await r.json();
            if (!d.ok) { alert('Erro ao criar refeição.'); return; }
            _logIdAtual = d.log_id;
        }

        const a = _alimentoAtual.por100g;
        const res = await fetch('/api/nutricao/item', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                log_id:        _logIdAtual,
                alimento_nome: _alimentoAtual.nome,
                quantidade_g:  g,
                kcal_100g:     a.kcal,
                proteina_100g: a.proteina,
                carbs_100g:    a.carbs,
                gordura_100g:  a.gordura,
                fibra_100g:    a.fibra,
                fonte:         _alimentoAtual.fonte,
                fonte_id:      _alimentoAtual.id,
            }),
        });
        const data = await res.json();
        if (!data.ok) { alert(data.erro || 'Erro ao adicionar item.'); return; }

        const f = g / 100;
        _itensSessao.push({ ...data.item, _nome: _alimentoAtual.nome });
        atualizarTotais(
            Math.round(a.kcal * f),
            parseFloat((a.proteina * f).toFixed(1)),
            parseFloat((a.carbs   * f).toFixed(1)),
            parseFloat((a.gordura * f).toFixed(1)),
            parseFloat((a.fibra   * f).toFixed(1))
        );
        atualizarKcalTipo(tipo, Math.round(a.kcal * f));
        atualizarItensSessao();
        voltarBusca();
    } catch (_) {
        alert('Erro de rede.');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-plus"></i> Adicionar à refeição';
    }
});

function atualizarItensSessao() {
    const wrapper = document.getElementById('nutri-itens-sessao');
    const lista   = document.getElementById('nutri-itens-lista');
    const totalEl = document.getElementById('nutri-itens-total');
    if (!_itensSessao.length) { wrapper.style.display = 'none'; return; }
    wrapper.style.display = 'block';
    lista.innerHTML = _itensSessao.map(i => `
        <section class="nutri-item-sessao">
            <section class="nutri-item-sessao-info">
                <span class="nutri-item-sessao-nome">${esc(i._nome || i.alimento_nome)}</span>
                <span class="nutri-item-sessao-qtd">${i.quantidade_g}g</span>
            </section>
            <span class="nutri-item-sessao-kcal">${Math.round(i.kcal)} kcal · P:${Number(i.proteina_g).toFixed(0)}g</span>
        </section>
    `).join('');
    const totKcal = _itensSessao.reduce((a, i) => a + Number(i.kcal), 0);
    const totProt = _itensSessao.reduce((a, i) => a + Number(i.proteina_g), 0);
    totalEl.innerHTML = `Total: <strong>${Math.round(totKcal)} kcal</strong> · P: ${totProt.toFixed(1)}g`;
}

// ═══════════════════════════════════════════════════════
// FOTO COM IA — reconhece múltiplos alimentos, depois pede peso de cada um
// ═══════════════════════════════════════════════════════

let _iaFotoFile  = null;
let _iaAlimentos = [];

function irParaStepIA(step) {
    ['foto', 'resultado', 'pesos', 'loading'].forEach(s => {
        const el = document.getElementById(s === 'loading' ? 'ia-loading' : `ia-step-${s}`);
        if (el) el.style.display = 'none';
    });
    const alvo = document.getElementById(step === 'loading' ? 'ia-loading' : `ia-step-${step}`);
    if (alvo) alvo.style.display = 'block';
}

function resetPreviewFotoIA() {
    _iaFotoFile = null;
    document.getElementById('ia-foto-area').style.display = 'flex';
    document.getElementById('ia-foto-preview-wrap').style.display = 'none';
    document.getElementById('ia-btn-analisar').style.display = 'none';
}

document.getElementById('nutri-foto-btn')?.addEventListener('click', () => {
    document.getElementById('modal-ia-foto').classList.add('open');
    _iaFotoFile = null;
    _iaAlimentos = [];
    resetPreviewFotoIA();
    irParaStepIA('foto');
});

document.getElementById('modal-ia-fechar')?.addEventListener('click', fecharModalIA);

function fecharModalIA() {
    document.getElementById('modal-ia-foto').classList.remove('open');
    _iaFotoFile = null;
    _iaAlimentos = [];
}

function selecionarFotoIA(file) {
    if (!file) return;
    _iaFotoFile = file;
    const url = URL.createObjectURL(file);
    document.getElementById('ia-foto-preview').src = url;
    document.getElementById('ia-foto-area').style.display = 'none';
    document.getElementById('ia-foto-preview-wrap').style.display = 'block';
    const btnAnalisar = document.getElementById('ia-btn-analisar');
    btnAnalisar.style.display = 'block';
    btnAnalisar.disabled = false;
}

document.getElementById('ia-input-galeria')?.addEventListener('change', e => selecionarFotoIA(e.target.files[0]));
document.getElementById('ia-input-camera')?.addEventListener('change', e => selecionarFotoIA(e.target.files[0]));
document.getElementById('ia-btn-galeria')?.addEventListener('click', () => document.getElementById('ia-input-galeria').click());
document.getElementById('ia-btn-camera')?.addEventListener('click', () => document.getElementById('ia-input-camera').click());
document.getElementById('ia-btn-trocar-foto')?.addEventListener('click', resetPreviewFotoIA);
document.getElementById('ia-btn-refazer')?.addEventListener('click', () => {
    _iaAlimentos = [];
    resetPreviewFotoIA();
    irParaStepIA('foto');
});

document.getElementById('ia-btn-analisar')?.addEventListener('click', async () => {
    if (!_iaFotoFile) return;
    irParaStepIA('loading');
    try {
        const fd = new FormData();
        fd.append('foto', _iaFotoFile);
        const r = await fetch('/api/nutricao/foto', { method: 'POST', body: fd }).then(x => x.json());
        if (!r.ok) throw new Error(r.erro || 'Erro na análise');

        const alimentos = r.analise?.alimentos || [];
        document.getElementById('ia-resultado-foto').src = r.fotoUrl;
        document.getElementById('ia-resultado-obs').textContent = r.analise?.observacao || '';
        renderizarAlimentosIA(alimentos);
        irParaStepIA('resultado');
    } catch (_) {
        alert('Não foi possível analisar a foto. Tente novamente.');
        irParaStepIA('foto');
    }
});

function renderizarAlimentosIA(alimentos) {
    _iaAlimentos = [...alimentos];
    const lista = document.getElementById('ia-alimentos-lista');
    if (!_iaAlimentos.length) {
        lista.innerHTML = '<p class="nutri-refeicao-vazio">Nenhum alimento identificado.</p>';
        return;
    }
    lista.innerHTML = _iaAlimentos.map((a, i) => `
        <section class="ia-alimento-item" data-index="${i}">
            <section class="ia-alimento-info">
                <section class="ia-alimento-nome">${esc(a.nome)}</section>
                <section class="ia-alimento-qtd">${esc(a.quantidade_estimada || '')}</section>
                <section class="ia-alimento-macros">
                    ${Math.round(a.kcal || 0)}kcal · P${a.proteina_g || 0}g · C${a.carbs_g || 0}g · G${a.gordura_g || 0}g
                </section>
            </section>
            <section class="ia-alimento-acoes">
                <span class="ia-confianca ia-confianca--${esc(a.confianca || 'baixa')}">${
                    a.confianca === 'alta' ? '✓' : a.confianca === 'media' ? '~' : '?'
                }</span>
                <button type="button" class="ia-btn-remover" data-index="${i}" title="Remover">
                    <i class="fas fa-times"></i>
                </button>
            </section>
        </section>
    `).join('');
}

document.getElementById('ia-alimentos-lista')?.addEventListener('click', e => {
    const btn = e.target.closest('.ia-btn-remover');
    if (!btn) return;
    _iaAlimentos.splice(parseInt(btn.dataset.index, 10), 1);
    renderizarAlimentosIA(_iaAlimentos);
});

document.getElementById('ia-btn-confirmar')?.addEventListener('click', () => {
    if (!_iaAlimentos.length) { alert('Adicione pelo menos um alimento.'); return; }
    const lista = document.getElementById('ia-pesos-lista');
    lista.innerHTML = _iaAlimentos.map((a, i) => `
        <section class="ia-peso-item">
            <section class="ia-peso-nome">${esc(a.nome)}</section>
            <section class="ia-peso-input-wrap">
                <input type="number" class="ia-peso-input" id="ia-peso-${i}"
                    value="${a.peso_estimado_g || ''}" placeholder="gramas" min="1" max="5000">
                <span class="ia-peso-unidade">g</span>
            </section>
        </section>
    `).join('');
    irParaStepIA('pesos');
});

// Salva cada alimento confirmado como um item da refeição em andamento
// (reaproveita /api/nutricao/item — o mesmo endpoint da busca manual).
document.getElementById('ia-btn-salvar-ia')?.addEventListener('click', async () => {
    if (!_logIdAtual || _tipoAtual === null) {
        alert('Abra uma refeição antes de salvar.');
        return;
    }
    const btn = document.getElementById('ia-btn-salvar-ia');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Salvando...';

    try {
        for (let i = 0; i < _iaAlimentos.length; i++) {
            const a = _iaAlimentos[i];
            const pesoEl = document.getElementById(`ia-peso-${i}`);
            const peso = parseFloat(pesoEl?.value) || a.peso_estimado_g || 100;
            const base = a.peso_estimado_g || 100;

            const res = await fetch('/api/nutricao/item', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    log_id:        _logIdAtual,
                    alimento_nome: a.nome,
                    quantidade_g:  peso,
                    kcal_100g:     ((a.kcal || 0)       / base) * 100,
                    proteina_100g: ((a.proteina_g || 0) / base) * 100,
                    carbs_100g:    ((a.carbs_g || 0)    / base) * 100,
                    gordura_100g:  ((a.gordura_g || 0)  / base) * 100,
                    fibra_100g:    ((a.fibra_g || 0)    / base) * 100,
                    fonte:         'ia',
                }),
            });
            const data = await res.json();
            if (!data.ok) continue;

            const item = data.item;
            _itensSessao.push({ ...item, _nome: a.nome });
            atualizarTotais(
                Number(item.kcal), Number(item.proteina_g), Number(item.carbs_g),
                Number(item.gordura_g), Number(item.fibra_g)
            );
            atualizarKcalTipo(_tipoAtual, Number(item.kcal));
        }
        fecharModalIA();
        fecharForm();
    } catch (_) {
        alert('Erro ao salvar alimentos.');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-check"></i> Salvar no diário';
    }
});

