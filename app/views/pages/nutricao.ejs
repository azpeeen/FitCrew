    setTimeout(() => document.getElementById('barcode-input')?.focus(), 100);
});

document.getElementById('modal-barcode-fechar')?.addEventListener('click', () => {
    pararScanner();
    document.getElementById('modal-barcode').classList.remove('open');
    _barcodeProduto = null;
});

// ── Scanner de câmera (html5-qrcode) ─────────────────────
document.getElementById('barcode-btn-scanner')?.addEventListener('click', async () => {
    if (typeof Html5Qrcode === 'undefined') {
        alert('Scanner não disponível. Digite o código manualmente.');
        return;
    }

    document.getElementById('barcode-scanner-wrap').style.display = 'block';
    document.getElementById('barcode-btn-scanner').style.display = 'none';

    _html5QrScanner = new Html5Qrcode('barcode-scanner-preview');
    try {
        await _html5QrScanner.start(
            { facingMode: 'environment' },
            { fps: 10, qrbox: { width: 250, height: 100 } },
            decodedText => {
                pararScanner();
                document.getElementById('barcode-input').value = decodedText;
                buscarBarcode();
            },
            () => {} // ignora erros de frame sem código — é o normal a cada frame
        );
    } catch (_) {
        pararScanner();
        alert('Não foi possível acessar a câmera.');
    }
});

document.getElementById('barcode-btn-parar-scanner')?.addEventListener('click', pararScanner);

function pararScanner() {
    if (_html5QrScanner) {
        _html5QrScanner.stop().catch(() => {});
        _html5QrScanner = null;
    }
    const wrap = document.getElementById('barcode-scanner-wrap');
    if (wrap) wrap.style.display = 'none';
    const btn = document.getElementById('barcode-btn-scanner');
    if (btn) btn.style.display = 'inline-flex';
}

document.getElementById('barcode-btn-buscar')?.addEventListener('click', buscarBarcode);
document.getElementById('barcode-input')?.addEventListener('keydown', e => {
    if (e.key === 'Enter') buscarBarcode();
});

async function buscarBarcode() {
    const codigo = document.getElementById('barcode-input').value.trim();
    if (!codigo) return;

    document.getElementById('barcode-resultado').style.display = 'none';
    document.getElementById('barcode-erro').style.display = 'none';
    document.getElementById('barcode-loading').style.display = 'block';

    try {
        const r = await fetch('/api/nutricao/barcode', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ codigo }),
        }).then(x => x.json());

        document.getElementById('barcode-loading').style.display = 'none';

        if (!r.ok) {
            document.getElementById('barcode-erro').textContent = r.erro || 'Produto não encontrado.';
            document.getElementById('barcode-erro').style.display = 'block';
            return;
        }

        _barcodeProduto = r.produto;
        document.getElementById('barcode-produto-nome').textContent = r.produto.nome;
        document.getElementById('barcode-produto-marca').textContent = r.produto.marca || '';

        const img = document.getElementById('barcode-produto-foto');
        if (r.produto.foto_url) { img.src = r.produto.foto_url; img.style.display = 'block'; }
        else { img.style.display = 'none'; }

        document.getElementById('barcode-peso').value = r.produto.porcao_g || 100;
        document.getElementById('barcode-porcao-hint').textContent =
            r.produto.porcao_g ? `Porção sugerida: ${r.produto.porcao_g}g` : '';

        atualizarMacrosBarcode();
        document.getElementById('barcode-resultado').style.display = 'block';
    } catch (_) {
        document.getElementById('barcode-loading').style.display = 'none';
        document.getElementById('barcode-erro').textContent = 'Erro ao buscar produto.';
        document.getElementById('barcode-erro').style.display = 'block';
    }
}

document.getElementById('barcode-peso')?.addEventListener('input', atualizarMacrosBarcode);

function atualizarMacrosBarcode() {
    if (!_barcodeProduto) return;
    const peso  = parseFloat(document.getElementById('barcode-peso').value) || 100;
    const fator = peso / 100;
    const p     = _barcodeProduto.por100g;
    document.getElementById('barcode-macros-preview').innerHTML = `
        <section class="barcode-macros-grid">
            <section class="barcode-macro"><span>${Math.round(p.kcal * fator)}</span>kcal</section>
            <section class="barcode-macro"><span>${(p.proteina * fator).toFixed(1)}g</span>Proteína</section>
            <section class="barcode-macro"><span>${(p.carbs * fator).toFixed(1)}g</span>Carbs</section>
            <section class="barcode-macro"><span>${(p.gordura * fator).toFixed(1)}g</span>Gordura</section>
        </section>`;
}

document.getElementById('barcode-btn-salvar')?.addEventListener('click', async () => {
    if (!_barcodeProduto || !_logIdAtual || _tipoAtual === null) return;
    const peso = parseFloat(document.getElementById('barcode-peso').value) || 100;
    const p    = _barcodeProduto.por100g;

    const btn = document.getElementById('barcode-btn-salvar');
    btn.disabled = true;
    try {
        const res = await fetch('/api/nutricao/item', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                log_id:        _logIdAtual,
                alimento_nome: _barcodeProduto.nome,
                quantidade_g:  peso,
                kcal_100g:     p.kcal,
                proteina_100g: p.proteina,
                carbs_100g:    p.carbs,
                gordura_100g:  p.gordura,
                fibra_100g:    p.fibra || 0,
                fonte:         'openfoodfacts',
                fonte_id:      _barcodeProduto.codigo,
            }),
        });
        const data = await res.json();
        if (!data.ok) { alert(data.erro || 'Erro ao salvar.'); return; }

        const item = data.item;
        _itensSessao.push({ ...item, _nome: _barcodeProduto.nome });
        atualizarTotais(
            Number(item.kcal), Number(item.proteina_g), Number(item.carbs_g),
            Number(item.gordura_g), Number(item.fibra_g)
        );
        atualizarKcalTipo(_tipoAtual, Number(item.kcal));

        document.getElementById('modal-barcode').classList.remove('open');
        _barcodeProduto = null;
        fecharForm();
    } catch (_) {
        alert('Erro ao salvar produto.');
    } finally {
        btn.disabled = false;
    }
});

