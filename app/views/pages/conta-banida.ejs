<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Conta banida — FitCrew</title>
<meta name="robots" content="noindex, nofollow">
<link rel="icon" type="image/x-icon" href="/images/favicon.ico">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; font-family: 'Segoe UI', system-ui, sans-serif; }
body {
    background: #0a0a0a; color: #f0f0f0;
    display: flex; align-items: center; justify-content: center;
    min-height: 100vh; padding: 24px;
}
.bloqueio-box {
    background: rgba(20,20,20,0.95);
    border: 1px solid rgba(239,68,68,0.3);
    border-radius: 20px;
    padding: 44px 36px;
    max-width: 440px;
    width: 100%;
    text-align: center;
    box-shadow: 0 32px 80px rgba(0,0,0,0.6);
}
.bloqueio-icon {
    width: 64px; height: 64px; border-radius: 50%;
    background: rgba(239,68,68,0.12); color: #ef4444;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.6rem; margin: 0 auto 20px;
}
h1 { font-size: 1.3rem; font-weight: 800; margin-bottom: 10px; }
.bloqueio-sub { color: #999; font-size: 0.9rem; margin-bottom: 4px; }
.bloqueio-motivo {
    background: rgba(255,255,255,0.04);
    border: 1px solid #2a2a2a;
    border-radius: 10px;
    padding: 12px 16px;
    margin: 20px 0;
    font-size: 0.85rem;
    color: #ccc;
    text-align: left;
}
.bloqueio-motivo strong { color: #ef4444; }
.apelacao-form { margin-top: 24px; text-align: left; }
.apelacao-form textarea {
    width: 100%; min-height: 90px; resize: vertical;
    background: #1a1a1a; border: 1px solid #333; border-radius: 8px;
    color: #f0f0f0; padding: 10px 14px; font-size: 0.875rem; font-family: inherit; outline: none;
}
.apelacao-form textarea:focus { border-color: #C98B1D; }
.apelacao-msg { font-size: 0.8rem; margin: 8px 0; min-height: 1em; }
.btn-apelar {
    width: 100%; padding: 12px; border-radius: 10px; border: none;
    background: #C98B1D; color: #000; font-size: 0.9rem; font-weight: 700;
    cursor: pointer; font-family: inherit; margin-top: 10px;
}
.btn-apelar:hover { opacity: 0.85; }
.btn-apelar:disabled { opacity: 0.5; cursor: default; }
.bloqueio-logout { margin-top: 20px; }
.bloqueio-logout button {
    background: none; border: none; color: #666; font-size: 0.8rem;
    cursor: pointer; font-family: inherit;
}
.bloqueio-logout button:hover { color: #999; }
</style>
</head>
<body>
<section class="bloqueio-box">
    <section class="bloqueio-icon"><i class="fas fa-ban"></i></section>
    <h1>Sua conta foi banida</h1>
    <p class="bloqueio-sub">Banimento permanente — violação grave das diretrizes</p>

    <% if (motivo) { %>
    <section class="bloqueio-motivo"><strong>Motivo:</strong> <%= motivo %></section>
    <% } %>

    <section class="apelacao-form" id="apelacaoForm">
        <label for="apelacao-mensagem" style="font-size:0.8rem;color:#888;display:block;margin-bottom:6px">
            Quer contestar? Envie uma apelação:
        </label>
        <textarea id="apelacao-mensagem" placeholder="Explique por que sua conta deveria ser reativada..." maxlength="1000"></textarea>
        <p class="apelacao-msg" id="apelacao-msg"></p>
        <button type="button" class="btn-apelar" id="btnEnviarApelacao">Enviar apelação</button>
    </section>

    <section class="bloqueio-logout">
        <form action="/logout" method="POST" style="margin:0">
            <button type="submit">Sair da conta</button>
        </form>
    </section>
</section>

<script>
document.getElementById('btnEnviarApelacao').addEventListener('click', async function () {
    const btn = this;
    const msgEl = document.getElementById('apelacao-msg');
    const mensagem = document.getElementById('apelacao-mensagem').value.trim();
    msgEl.textContent = '';
    msgEl.style.color = '#ef4444';

    if (mensagem.length < 10) {
        msgEl.textContent = 'Escreva pelo menos 10 caracteres.';
        return;
    }

    btn.disabled = true;
    btn.textContent = 'Enviando...';
    try {
        const r = await fetch('/api/apelacao', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ mensagem }),
        }).then(x => x.json());

        if (r.ok) {
            msgEl.style.color = '#22c55e';
            msgEl.textContent = r.mensagem || 'Apelação enviada.';
            document.getElementById('apelacao-mensagem').disabled = true;
            btn.remove();
        } else {
            msgEl.textContent = r.erro || 'Erro ao enviar apelação.';
            btn.disabled = false;
            btn.textContent = 'Enviar apelação';
        }
    } catch (_) {
        msgEl.textContent = 'Erro ao enviar apelação.';
        btn.disabled = false;
        btn.textContent = 'Enviar apelação';
    }
});
</script>
</body>
</html>
